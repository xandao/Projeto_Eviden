➡️  Script de submissão: 

#!/bin/bash
#SBATCH --nodes=3
#SBATCH --ntasks-per-node=2
#SBATCH --ntasks=6
#SBATCH --cpus-per-task=4
#SBATCH --partition=sequana_cpu_dev
#SBATCH --job-name=teste-raxml-customizado
#SBATCH --time=00:20:00
#SBATCH --exclusive
#SBATCH --mem=350G

module load raxml

cd $SLURM_SUBMIT_DIR

ulimit -s unlimited
ulimit -c unlimited
ulimit -v unlimited

EXEC="/petrobr/app_sequana/raxml/8.2.12/bin/raxmlHPC-HYBRID-AVX"

PARAMS="-T $SLURM_CPUS_PER_TASK -N 100 -s ../tests/DENV_2-colombia-BVBRC_genome_sequence.mafft -m GTRGAMMA -p 112233 -b 223344 -n DENV_2-colombia-BVBRC_genome_sequence_raxml.phylip_tree2.raxml -c 4 -f d"

if [ $SLURM_NTASKS_PER_NODE -eq 1 ]; then
  CPU_BIND="none"
else 
  CPU_BIND="socket"
fi       

srun -n $SLURM_NTASKS -c $SLURM_CPUS_PER_TASK --cpu-bind=$CPU_BIND $EXEC $PARAMS



