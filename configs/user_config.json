{
  "default_script_name": "script.sh",
  "enable_submission_log": true,
  "slurm": {
    "submission_program": "sbatch",
    "submission_message": ".*Submitted batch job (\\d+).*"
  },
  "custom_restrictions": [
    {
      "name": "threads_per_node",
      "operation": ["mul", "Processo p/ no", "Thread p/ proc."],
      "result": ["max", "Thread p/ proc."]
    }
  ]
}
